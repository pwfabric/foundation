                }
              }
            ]
          },
          {
            "id": "{{ID}}-c3",
            "type": "container",
            "props": {
              "direction": "column",
              "gap": 6,
              "padding": 0
            },
            "children": [
              {
                "id": "{{ID}}-c3t",
                "type": "heading",
                "props": {
                  "text": "{{COL_TITLE_3}}",
                  "level": "h5"
                }
              },
              {
                "id": "{{ID}}-c3l1",
