                }
              }
            ]
          },
          {
            "id": "{{ID}}-c2",
            "type": "container",
            "props": {
              "direction": "column",
              "gap": 6,
              "padding": 0
            },
            "children": [
              {
                "id": "{{ID}}-c2t",
                "type": "heading",
                "props": {
