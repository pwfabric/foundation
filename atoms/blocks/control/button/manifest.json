          "default": "primary"
        },
        "bindable": false
      },
      {
        "name": "size",
        "type": "\"small\" | \"medium\" | \"large\"",
        "required": false,
        "default": "medium",
        "jsonSchema": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
